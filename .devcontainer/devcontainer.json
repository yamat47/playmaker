{
  "name": "playmaker",
  "dockerComposeFile": "../docker/compose.yaml",
  "service": "workspace",
  // Open library/. The Biome / TypeScript / Vitest extensions look for node_modules and the
  // configuration files directly under the workspace, so they do not work when the repository root is opened
  "workspaceFolder": "/workspace/library",
  "remoteUser": "node",
  "postCreateCommand": "pnpm install",
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      // The typescript package of TypeScript 7 does not bundle tsserver, so editor type checking
      // runs on tsgo from the Native Preview extension. Pointing typescript.tsdk at node_modules stops the language features
      "extensions": ["biomejs.biome", "vitest.explorer", "TypeScriptTeam.native-preview"],
      "settings": {
        // .git is one level up (at the repository root)
        "git.openRepositoryInParentFolders": "always",
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports.biome": "explicit",
          "quickfix.biome": "explicit"
        },
        "typescript.experimental.useTsgo": true
      }
    }
  }
}
