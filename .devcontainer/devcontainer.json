{
  "name": "playmaker",
  "dockerComposeFile": "../docker/compose.yaml",
  "service": "workspace",
  // library/ を開く。Biome / TypeScript / Vitest の拡張はワークスペース直下の
  // node_modules と設定ファイルを探すため、リポジトリのルートで開くと動かない
  "workspaceFolder": "/workspace/library",
  "remoteUser": "node",
  "postCreateCommand": "pnpm install",
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      // TypeScript 7 の typescript パッケージは tsserver を同梱しないので、エディタの型検査は
      // Native Preview 拡張の tsgo で動かす。typescript.tsdk で node_modules を指すと言語機能が止まる
      "extensions": ["biomejs.biome", "vitest.explorer", "TypeScriptTeam.native-preview"],
      "settings": {
        // .git はひとつ上（リポジトリのルート）にある
        "git.openRepositoryInParentFolders": "always",
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports.biome": "explicit",
          "quickfix.biome": "explicit"
        },
        "typescript.experimental.useTsgo": true
      }
    }
  }
}
