{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": ["src/**", "demo/**", "*.ts", "*.json", "*.jsonc"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // tsc detects type-only imports that lack type through verbatimModuleSyntax.
        // Checking it in Biome too would report the same finding from two places, so leave it to tsc.
        "useImportType": "off",
        "noParameterProperties": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      }
    }
  },
  // Options for the same rule are not merged across overrides, so each override lists all the groups it forbids.
  "overrides": [
    {
      "includes": ["src/common/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/browser", "**/browser/**", "**/playmaker.js"],
                    "message": "Do not import browser or the public entry from common. Code that touches the DOM belongs in browser."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/common/**", "!src/common/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/browser", "**/browser/**", "**/playmaker.js"],
                    "message": "Do not import browser or the public entry from common. Code that touches the DOM belongs in browser."
                  },
                  {
                    "group": ["**/test-support/**"],
                    "message": "test-support is used only from tests. It is excluded from the build, so importing it from the main code breaks the type declarations."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/browser/**", "src/playmaker.ts", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/test-support/**"],
                    "message": "test-support is used only from tests. It is excluded from the build, so importing it from the main code breaks the type declarations."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
