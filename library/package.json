{
  "name": "playmaker",
  "version": "0.0.0",
  "private": true,
  "description": "アメリカンフットボールのプレー図を作成・表示する JavaScript ライブラリ",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/playmaker.d.ts",
      "import": "./dist/playmaker.js"
    },
    "./styles.css": "./dist/playmaker.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite demo --config vite.config.ts",
    "build": "vite build",
    "test": "vitest run --coverage --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project node",
    "typecheck": "tsc -b",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:browser && pnpm run build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "font": "node scripts/generate-field-font.mjs",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@microsoft/api-extractor": "^7.60.0",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "playwright": "1.64.1",
    "subset-font": "^2.9.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  }
}
